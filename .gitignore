# The built UI: produced by the Dockerfile's `ui` stage and copied in for go:embed. Never committed,
# because a stale bundle served in place of the real one looks like "the UI is wrong" rather than
# "the build is wrong".
cmd/gitdev-ext/ui/*
!cmd/gitdev-ext/ui/.gitkeep

ui/node_modules/
ui/dist/

# Built binaries. `go build ./cmd/x` drops the result in the working directory, and an executable
# committed by accident is that many megabytes for everyone who clones afterwards.
/e2e-all
/gitdev-ext
/sweep
